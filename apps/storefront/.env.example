# Copy to .env.local (git-ignored). Values for the valzaya-dev Supabase project only.

# Public (safe in the browser bundle): Supabase URL + publishable/anon key. RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-anon-key>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. NEVER prefix with NEXT_PUBLIC_. Used by route handlers / server actions only.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Providers (mock until real credentials exist — see CLAUDE.md "PROTOTYPE" mode)
PAYMENT_PROVIDER_MODE=mock
WAREHOUSE_PROVIDER_MODE=mock

# Waitlist storage. Leave unset for Supabase (the only option on Vercel). Set to `memory` for
# e2e tests or a credential-free local preview: sign-ups are kept in process memory and lost on restart.
# WAITLIST_STORE=memory
